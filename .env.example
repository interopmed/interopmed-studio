# ==============================================================================
# INTEROPMED STUDIO ENVIRONMENT CONFIGURATION
# ==============================================================================

# Website origin URL for single-sign-on (SSO) handoff and redirects
INTEROPMED_WEBSITE_URL="https://www.interopmed.com"

# Shared HMAC-SHA256 secret key for signing & verifying launch tokens
INTEROPMED_STUDIO_SHARED_SECRET="interopmed-studio-shared-secret-key"

# Local development port (default: 3100)
PORT=3100
